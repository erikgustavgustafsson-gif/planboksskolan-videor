ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

# Alla adresser (http, www och den tillfälliga Strato-adressen) går till https://jamforprivatleasing.se
RewriteEngine On
RewriteCond %{HTTP_HOST} !^jamforprivatleasing\.se$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://jamforprivatleasing.se/$1 [R=301,L]

# Besökare får nya versioner direkt efter en uppdatering
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(jpg|png|svg|woff2)$">
    Header set Cache-Control "max-age=604800"
  </FilesMatch>
</IfModule>
